{
    "name": "word-collector",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "activeTab",
        "contextMenus",
        "storage"
    ],
    "externally_connectable": {
        "matches": [
            "https://word-collector-62657.web.app/*",
            "https://word-collector-62657.firebaseapp.com/*"
        ]
    },
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["main.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["content.css"],
            "matches": ["<all_urls>"]
        }
    ]
}